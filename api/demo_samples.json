 "Which properties have the most rent outstanding from current residents?": [
  {
   "type": "tool_start",
   "name": "query_kpis",
   "input": {
    "sql": "WITH cur AS (\n  SELECT DISTINCT tenant_id FROM reporting.leases\n  WHERE start_date <= DATE '2026-10-31' AND DATE '2026-10-31' < COALESCE(move_out_date, end_date)\n), o AS (\n  SELECT p.name AS property, l.tenant_id,\n    rl.amount_due - CASE WHEN rl.paid_on IS NOT NULL AND rl.paid_on <= DATE '2026-10-31' THEN COALESCE(rl.amount_paid,0) ELSE 0 END AS outstanding\n  FROM reporting.rent_ledger rl\n  JOIN reporting.leases l ON l.id = rl.lease_id\n  JOIN reporting.units u ON u.id = l.unit_id\n  JOIN reporting.properties p ON p.id = u.property_id\n  WHERE rl.due_date <= DATE '2026-10-31' AND l.tenant_id IN (SELECT tenant_id FROM cur)\n)\nSELECT property, ROUND(SUM(outstanding),2) AS outstanding_usd,\n  COUNT(DISTINCT tenant_id) FILTER (WHERE outstanding > 0) AS tenants_owing\nFROM o GROUP BY property HAVING SUM(outstanding) > 0\nORDER BY outstanding_usd DESC",
    "purpose": "Rent outstanding as of 2026-10-31 from current residents, by property"
   }
  },
