 "Which vendors handled HVAC tickets that breached SLA at Maple Court in July 2026?": [
  {
   "type": "tool_start",
   "name": "query_kpis",
   "input": {
    "sql": "WITH wo AS (\n  SELECT w.*, v.name AS vendor_name, v.trade,\n    CASE w.priority WHEN 'emergency' THEN 24 WHEN 'high' THEN 72 WHEN 'normal' THEN 168 WHEN 'low' THEN 336 END AS target_h\n  FROM reporting.work_orders w\n  JOIN reporting.properties p ON p.id = w.property_id\n  LEFT JOIN reporting.vendors v ON v.id = w.vendor_id\n  WHERE p.name ILIKE '%Maple Court%'\n    AND w.category ILIKE '%hvac%'\n    AND w.opened_at >= '2026-07-01' AND w.opened_at < '2026-08-01'\n    AND w.status <> 'cancelled'\n)\nSELECT COALESCE(vendor_name, '(no vendor)') AS vendor, trade,\n  COUNT(*) AS breached_tickets,\n  SUM(CASE WHEN status='open' THEN 1 ELSE 0 END) AS still_open,\n  ROUND(MAX(EXTRACT(EPOCH FROM (COALESCE(completed_at, TIMESTAMP '2026-10-31 23:59:59') - opened_at))/3600)::numeric,1) AS max_hours_to_close\nFROM wo\nWHERE (status='completed' AND completed_at - opened_at > make_interval(hours => target_h))\n   OR (status='open' AND TIMESTAMP '2026-10-31 23:59:59' - opened_at > make_interval(hours => target_h))\nGROUP BY 1,2\nORDER BY breached_tickets DESC",
    "purpose": "Vendors on Maple Court HVAC tickets opened July 2026 that breached SLA"
   }
  },
  {
   "type": "sql_result",
   "id": "S1",
   "purpose": "Vendors on Maple Court HVAC tickets opened July 2026 that breached SLA",
   "sql": "WITH wo AS (SELECT w.*, v.name AS vendor_name, v.trade, CASE w.priority WHEN 'emergency' THEN 24 WHEN 'high' THEN 72 WHEN 'normal' THEN 168 WHEN 'low' THEN 336 END AS target_h FROM reporting.work_orders AS w JOIN reporting.properties AS p ON p.id = w.property_id LEFT JOIN reporting.vendors AS v ON v.id = w.vendor_id WHERE p.name ILIKE '%Maple Court%' AND w.category ILIKE '%hvac%' AND w.opened_at >= '2026-07-01' AND w.opened_at < '2026-08-01' AND w.status <> 'cancelled') SELECT COALESCE(vendor_name, '(no vendor)') AS vendor, trade, COUNT(*) AS breached_tickets, SUM(CASE WHEN status = 'open' THEN 1 ELSE 0 END) AS still_open, ROUND(CAST(MAX(EXTRACT(EPOCH FROM (COALESCE(completed_at, CAST('2026-10-31 23:59:59' AS TIMESTAMP)) - opened_at)) / 3600) AS DECIMAL), 1) AS max_hours_to_close FROM wo WHERE (status = 'completed' AND completed_at - opened_at > MAKE_INTERVAL(hours => target_h)) OR (status = 'open' AND CAST('2026-10-31 23:59:59' AS TIMESTAMP) - opened_at > MAKE_INTERVAL(hours => target_h)) GROUP BY 1, 2 ORDER BY breached_tickets DESC LIMIT 201",
