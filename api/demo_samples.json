 "Show occupancy by property as a bar chart.": [
  {
   "type": "tool_start",
   "name": "query_kpis",
   "input": {
    "sql": "SELECT p.name AS property, COUNT(u.id) AS total_units, COUNT(DISTINCT a.unit_id) AS occupied_units, ROUND(100.0 * COUNT(DISTINCT a.unit_id) / NULLIF(COUNT(DISTINCT u.id),0), 1) AS occupancy_pct FROM reporting.properties p JOIN reporting.units u ON u.property_id = p.id LEFT JOIN (SELECT DISTINCT unit_id FROM reporting.leases WHERE start_date <= DATE '2026-10-31' AND DATE '2026-10-31' < COALESCE(move_out_date, end_date)) a ON a.unit_id = u.id GROUP BY p.name ORDER BY occupancy_pct DESC",
    "purpose": "Occupancy by property as of 2026-10-31"
   }
