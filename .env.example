# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=leaselens
POSTGRES_PASSWORD=leaselens
POSTGRES_DB=leaselens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Read-only role used by the agent's text-to-SQL tool
POSTGRES_RO_USER=leaselens_ro
POSTGRES_RO_PASSWORD=leaselens_ro
# Hosted DB (Neon) instead of the POSTGRES_* parts; leave unset locally
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

ANTHROPIC_API_KEY=
LEASELENS_MODEL=claude-opus-5-5

PINECONE_API_KEY=
PINECONE_INDEX=leaselens-docs

SLACK_WEBHOOK_URL=
# Shared secret for POST /digest/run (the weekly GitHub Action). Generate: openssl rand -hex 32
DIGEST_RUN_TOKEN=
# false on the public demo: preview only, no Send now
DIGEST_SEND_ENABLED=true

SEED=42

# Public demo guards (docs/deploy.md). Locally: DEMO_MODE=false, guards off.
DEMO_MODE=false
DAILY_SPEND_CAP_USD=2
AGENT_QUESTIONS_PER_HOUR=10
DIGEST_BUILDS_PER_HOUR=3
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173
